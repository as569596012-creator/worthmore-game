# 复制为 .env.local 并按需填写。带 NEXT_PUBLIC_ 前缀才能在浏览器端可用。

# 上线前必须改成真实域名(影响 canonical / sitemap / 分享卡水印)
NEXT_PUBLIC_SITE_URL=https://worthmore.app
NEXT_PUBLIC_SITE_NAME=WorthMore

# E-E-A-T 署名与联系邮箱
NEXT_PUBLIC_AUTHOR_NAME=The WorthMore Team
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# 变现 / 分析(留空则不加载任何外部脚本)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
